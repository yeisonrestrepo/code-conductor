{
  "name": "@yeison.restrepo.r/code-conductor",
  "version": "1.34.4",
  "description": "A governance layer for Claude Code sessions: hooks that check an agent's commands before they run, a spec-first workflow, and project memory the next session reads.",
  "keywords": [
    "agentic-development",
    "ai-agents",
    "claude",
    "claude-code",
    "claude-code-hooks",
    "claudecode",
    "cli",
    "developer-tools",
    "guardrails",
    "skills",
    "spec-driven-development"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeisonrestrepo/code-conductor.git"
  },
  "type": "module",
  "bin": {
    "code-conductor": "bin/code-conductor.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "global/",
    "skills/",
    "scripts/",
    "project-template/"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
